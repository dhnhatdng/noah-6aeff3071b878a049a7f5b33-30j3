# Copy to .env and fill in your own values. Never commit a real key.
# VITE_SOLANA_RPC_URL is optional — without it the app falls back to the public Devnet cluster URL.
VITE_SOLANA_RPC_URL=https://your-rpc-endpoint.example
# VITE_SOLANA_NETWORK=devnet
# VITE_ENABLE_GUEST_MODE=true
# Supabase (enables live profiles, connections and photo uploads; without
# these the app runs in demo mode with localStorage only). Use the PUBLIC
# anon key only — never put a service-role key in this file.
# Get them from the Supabase dashboard: Project Settings -> API.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-public-anon-key
# After setting them, run supabase/migrations/0001_init.sql in the SQL editor,
# create a public Storage bucket named `avatars`, and enable anonymous
# sign-ins (Authentication -> Sign-in providers -> Anonymous).
# Google sign-in (optional, needs the setup in README "Google sign-in"):
# VITE_GOOGLE_AUTH_ENABLED=false
